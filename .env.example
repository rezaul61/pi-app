# Required: PostgreSQL connection string. Use a dedicated least-privilege app user.
DATABASE_URL=postgresql://pi_app:replace-with-strong-password@localhost:5432/pi

# Required in production when the app is behind a proxy. No trailing slash.
APP_ORIGIN=https://pi.example.com

# Optional, comma-separated preview hosts permitted by Next.js development tooling.
ALLOWED_DEV_ORIGINS=
